# Copy to .env.local and fill in. Never commit real values. API keys exist only on the server (rule 5).

# --- Supabase (P0-1 only creates the clients; no tables yet) ---
# These two are public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Providers (rule 8). Names must be registered in lib/<kind>/index.ts ---
# stt: mock, deepgram, openai    llm: mock, openai, gemini    tts: mock only so far.
# In production these must be set explicitly. The voice test also takes --stt and --llm on the command line.
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
# "manual" (wallet transfer + admin approval, the Phase 1 flow) or "mock"
PAYMENTS_PROVIDER=manual

# --- Provider keys: only for the providers you choose, only in .env.local on your own computer ---
# Never put a key in chat, in git, or in a file that is committed.
# Deepgram speech-to-text. The adapter always sends mip_opt_out=true, because Deepgram otherwise
# uses audio to improve its models and Bolo promises users that never happens.
DEEPGRAM_API_KEY=
# OpenAI, for speech-to-text and for the feedback model. API data is not used for training by default.
OPENAI_API_KEY=
# Google Gemini feedback model. The key MUST come from a project with Cloud Billing switched on:
# Google keeps content out of its product training only for paid usage.
GEMINI_API_KEY=

# Optional overrides (the defaults and the dates they were checked are at the top of each adapter file).
# Vendor prices are tagged [VERIFY]: if a provider dashboard bills something different, set the price here.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_USD_PER_MINUTE=0.0043
# OPENAI_STT_MODEL=gpt-transcribe
# OPENAI_STT_USD_PER_MINUTE=0.0045
# OPENAI_LLM_MODEL=gpt-5.4-mini
# OPENAI_LLM_USD_PER_M_INPUT=0.75
# OPENAI_LLM_USD_PER_M_OUTPUT=4.5
# OPENAI_LLM_REASONING_EFFORT=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_USD_PER_M_INPUT=1.5
# GEMINI_USD_PER_M_OUTPUT=7.5
# GEMINI_THINKING_LEVEL=low   # leave the value empty to send no thinking setting

# --- Cost (rule 6) ---
# PKR per 1 USD, used to turn provider cost into PKR on every attempt.
# 280 is the planning rate from Business Plan v2.1; set the current rate.
FX_PKR_PER_USD=280

# --- Admin (rule 10): comma-separated emails allowed into admin routes. Used from screen A01. ---
ADMIN_EMAILS=

# --- Logging: debug | info | warn | error ---
LOG_LEVEL=info
